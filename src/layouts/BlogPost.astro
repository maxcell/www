---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {ogImage?: string};

const { title, description, date, ogImage } = Astro.props;

---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
		<style>
			.title {
				font-size: 2em;
				margin: 0.25em 0 0;
			}
			hr {
				border-top: 1px solid #ddd;
				margin: 1rem 0;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<header style="background-color:#EBE0F0;" class="md:h-96">
			<div class="py-8 px-2 max-w-[80ch] mx-auto">
				<nav class="flex justify-between">
					<a class="text-2xl font-bold" href="/">Prince</a>
					<ul class="flex gap-8">
						<a class="text-2xl font-bold" href="/blog">Blog</a>
						<a class="text-2xl font-bold" href="/about">About</a>
						<a class="text-2xl font-bold" href="/links">Links</a>
					</ul>
				</nav>
			</div>
		</header>
		<main>
			<article class="px-8 max-w-[80ch] mx-auto pt-10 flex flex-col gap-4 sm:px-8">
				<h1 class="title">{title}</h1>
				<FormattedDate date={date} />
				<hr />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

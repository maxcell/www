---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & {ogImage?: string};

const { title, description, date, ogImage } = Astro.props;

---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
		<style>
			.cropped-image-clip-rectangle {
				height: 100%;
				width: 100%;
				margin-top: 35px;
			}
			@media (min-width: 772px) {
				.cropped-image-clip-rectangle {
					clip-path: inset(33px 169px 160px 186px round 40px);
					margin-top: -45px;
					height: 100%;
				}
			}
			.title {
				font-size: 2em;
				margin: 0.25em 0 0;
			}
			hr {
				border-top: 1px solid #ddd;
				margin: 1rem 0;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="px-8 max-w-[80ch] mx-auto pt-10 flex flex-col gap-4 sm:px-8 prose lg:prose-xl">
			<article>
				<h1 class="title">{title}</h1>
				<FormattedDate date={date} />
				<hr />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { Image } from "astro:assets";
import Self from "../assets/dork-prince.png";

import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import BlogCard from "../components/BlogCard.astro";
import { getEntry } from "astro:content";

const contextPost = await getEntry('blog', "reuse-context")
const arduinoPost = await getEntry('blog', "arduino-uno-project")
const twitchPost = await getEntry('blog', 'create-browser-source-obs')
const wasmPost = await getEntry('blog', 'rust-wasm')

const interestingPosts = [contextPost, arduinoPost, twitchPost, wasmPost]

---

<html>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.cropped-image-clip-rectangle {
				height: 100%;
				width: 100%;
				margin-top: 35px;
			}
			@media (min-width: 772px) {
				.cropped-image-clip-rectangle {
					clip-path: inset(33px 169px 160px 186px round 40px);
					margin-top: -45px;
					height: 100%;
				}
			}

			body {
				min-height: 100vh;
				display: grid;
				grid-template-rows: auto 1fr auto;
			}
		</style>
	</head>

	<body>
		<Header/>
		<main class="px-8 max-w-[80ch] mx-auto pt-10 flex flex-col gap-4 sm:px-8">
			<article>
				<p class="text-3xl font-extrabold pb-8">Howdy there!</p>
				<p class="text-lg">
					I am a full-stack web developer based in NYC. I love building things
					and making sure to bring people together around accessibility and
					security. Beyond the work I do, I love corgis.
				</p>
			</article>
			<article class="pt-10">
				<h2 class="text-md font-extralight uppercase">Featured Posts</h2>
				<ul class="pt-10 flex flex-col gap-8">
					{interestingPosts.map((post) => <BlogCard title={post.data.title} description={post.data.description} slug={post.slug} />)}
				</ul>
			</article>
		</main>
		<Footer />

	</body><!-- <BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  
</BaseLayout> -->
</html>

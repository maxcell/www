---
const {description, title, slug} = Astro.props
---


<li
  class="mx-auto max-w-[740px] bg-[#EBE0F0] rounded-lg"
  style="word-break:break-word;width:min(80ch, 90%);padding:clamp(.75rem, 3%, 2rem);"
>
  <h3 class="pb-4 font-bold text-2xl">{title}</h3>
  <p>
    {description}
  </p>
  <a
    class="inline-flex mt-4 underline"
    style="width:fit-content"
    href={`/blog/${slug}/`}>Read more</a
  >
</li>